rules_version = '2';

// Reference ruleset for Firebase Storage (tiffinbox-2cb8b project). Like
// firestore.rules, this is NOT auto-synced — it must be manually pasted into
// Firebase Console -> Storage -> Rules and published to take effect.
//
// bkash_proofs/{customerId}/{fileName} — payment-proof screenshots uploaded
// by FirebaseStorageRepository.kt when a customer pays via bKash at
// checkout. Only the owning customer may upload into their own folder
// (capped at 5MB, images only); any signed-in user may read one, since the
// chef fulfilling the order and any admin both need to view it, and the
// path (customerId + upload timestamp) is not guessable or listable by
// other users.
service firebase.storage {
  match /b/{bucket}/o {
    match /bkash_proofs/{customerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == customerId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
