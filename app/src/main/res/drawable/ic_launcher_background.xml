<!--
  Adaptive-icon background: the same brand gradient TiffinButton and the Home
  header use (BrandColors.gradientStart -> gradientEnd for the Black & Red
  palette, see ui/theme/Color.kt). Full-bleed and fully opaque, as an adaptive
  background must be - the launcher masks it to whatever shape it wants.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FFFF3B4E" />
                <item android:offset="1" android:color="#FF8E0E1C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
