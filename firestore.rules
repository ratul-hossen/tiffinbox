rules_version = '2';

// Reference ruleset matching the data models in README.md (User, Chef, Meal,
// Order, Review). This is the ruleset actually published in Firebase
// Console -> Firestore Database -> Rules for the tiffinbox-2cb8b project
// (not auto-synced — any further change to this file must be manually
// re-pasted and re-published there to take effect). Not consumed by the
// Android build itself; this file is the source of truth to keep in sync
// with what's deployed.
//
// admin-web (see /admin-web) additions: an isAdmin()/isSuperAdmin() helper,
// an admins/{adminId} collection, a subscriptions/{subscriptionId}
// collection, and broadened admin read/write on chefs, meals, orders,
// reviews, users and subscriptions, below.
//
// Delivery-system groundwork: delivery_applications/{chefUid} (chefs apply
// for TiffinBox delivery; admin approval unlocks deliveryMode "tiffinbox"), a delivery_partners/{partnerId} collection
// (admin-provisioned accounts only, no self-signup), and orders/{orderId}
// read/update access for the delivery partner assigned to that order
// (deliveryPartnerId) — for the separate delivery-partner app, not yet built.
//
// Recycle Bin: an admin-only recycle_bin/{entryId} collection (see below)
// that every admin-web "Delete" button (and "Cancel" on an order) now
// writes a snapshot to before the real delete, so deletions are restorable.
// chefs/{chefId}, reviews/{reviewId} and orders/{orderId} `create` now also
// accept isAdmin() (in addition to their normal owner check) so the Recycle
// Bin can restore those doc types back to their original id on behalf of
// someone else. users/{userId} already accepted isAdmin() on create, so no
// change was needed there for user removal to be restorable too.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin-web helper: a uid with a document at admins/{uid} is treated as
    // an admin everywhere below. Added for the admin-web panel
    // (admin-web/) — see admins/{adminId} match block just below for how
    // that collection itself is guarded.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Super-admin: an admin whose own admins/{uid} doc has role ==
    // "super_admin". Only super admins may add or remove other admins (see
    // admins/{adminId} below) — this is the "extra power" the project owner
    // asked for hossen240504@gmail.com specifically.
    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "super_admin";
    }

    // admins/{adminId} — doc id = a Firebase Auth uid; its mere existence
    // marks that uid as an admin (see isAdmin() above), and its `role` field
    // ("super_admin" | "admin") marks the extra-power tier (see
    // isSuperAdmin() above). All admins may read this list (admin-web's
    // "Admins" page). Only a super admin may create a NEW admin (inviting
    // someone) or delete one (never themselves). The one narrow exception is
    // a one-time self-heal: the hardcoded super-admin email may set
    // role="super_admin" on their OWN existing doc if it doesn't have that
    // role yet — this is how the original bootstrap-created doc for
    // hossen240504@gmail.com (created before this role system existed) gets
    // upgraded, without ever allowing arbitrary signed-in users to grant
    // themselves admin access the way the old open bootstrap rule did.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isOwner(adminId) &&
        request.auth.token.email == "hossen240504@gmail.com" &&
        resource.data.get("role", null) != "super_admin" &&
        request.resource.data.role == "super_admin"
      );
      allow delete: if isSuperAdmin() && adminId != request.auth.uid;
    }

    // users/{userId} — profile data (name, phone, role, addresses)
    // Admins (admin-web) can read/write any user doc for moderation.
    // Hardening (2026-10-16): a user can't change their own `role` after
    // signup (e.g. a customer silently turning into a chef).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.get("role", "") == resource.data.get("role", ""));
      allow delete: if isOwner(userId) || isAdmin();

      // users/{uid}/agent_connections/{id} - AI agents (MCP) this customer has
      // connected (mcp-server/src/auth.ts). Only the MCP server creates them,
      // with its service account (which bypasses these rules); the owner sees
      // them in Profile -> AI Agent (MCP) and disconnects one by deleting it.
      // An admin can do the same from admin-web's User Details.
      match /agent_connections/{connectionId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if false;
      }
    }

    // mcp_pairing/{code} - the one-time code a customer creates in the app
    // to connect an AI agent. Nobody can read a code back (the MCP server
    // reads it with its service account); the doc id is the code itself, so
    // it must look like one, belong to the signed-in user and be stamped with
    // the server time (the MCP server rejects codes older than 5 minutes and
    // deletes each one when it is used). The owner may cancel their own.
    match /mcp_pairing/{code} {
      allow create: if isSignedIn()
        && code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow read, update: if false;
    }

    // mcp_blocks/{uid} - an admin switching AI agent access off for one
    // account (admin-web User Details). Kept out of users/{uid} on purpose:
    // the owner may delete and recreate their own user doc, which would
    // otherwise clear the block.
    match /mcp_blocks/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // chefs/{chefId} — public kitchen profiles, only the owning chef can edit.
    // The signup flow (see FirestoreChefRepository.kt) always creates this
    // doc at chefs/{uid} using the chef's own Firebase Auth uid as the doc
    // id, so create is restricted to that exact match — otherwise any
    // signed-in user could create or overwrite a kitchen profile under an id
    // they don't own. Admins (admin-web) can also edit/delete any chef
    // (verify, toggle availability, moderate). isAdmin() is also allowed on
    // create so admin-web's Recycle Bin (see recycle_bin/{entryId} below)
    // can restore a soft-deleted chef doc back to its original id even
    // though the admin isn't that chef's own uid.
    //
    // Hardening (2026-10-16): a chef can never approve themselves. On create
    // the doc must start unapproved (isVerified false), except admin-web's
    // seeded demo chefs (isDemo, fixed demo.*@tiffinbox.app accounts). On
    // update the owner can't touch the approval/demo fields at all - only
    // admin-web's Chef Approvals page (isAdmin()) can.
    function chefLockedFields() {
      return ["isVerified", "approvalStatus", "approvalUpdatedAt", "isDemo", "userId", "deliveryUntil", "nidVerified", "kitchenVerified", "maxDeliveryFee"];
    }
    // A chef may only switch to TiffinBox's delivery (which shows customers
    // the "TiffinBox Delivery" badge) while an admin-approved agreement in
    // delivery_applications/{chefId} is still running (validUntil in the
    // future). Switching back to "self" is always allowed. deliveryUntil
    // itself is admin-only (chefLockedFields).
    function chefDeliveryModeAllowed(chefId) {
      return request.resource.data.get("deliveryMode", "self") != "tiffinbox" ||
        (resource != null && resource.data.get("deliveryMode", "self") == "tiffinbox") ||
        (exists(/databases/$(database)/documents/delivery_applications/$(chefId)) &&
          get(/databases/$(database)/documents/delivery_applications/$(chefId)).data.status == "approved" &&
          get(/databases/$(database)/documents/delivery_applications/$(chefId)).data.get("validUntil", 0) > request.time.toMillis());
    }
    match /chefs/{chefId} {
      allow read: if true;
      allow create: if isAdmin() || (isOwner(chefId) && chefDeliveryModeAllowed(chefId) && (
        request.resource.data.get("isVerified", false) == false ||
        (request.resource.data.get("isDemo", false) == true &&
          request.auth.token.email.matches("^demo[.].*@tiffinbox[.]app$"))
      ));
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(chefLockedFields()) &&
        chefDeliveryModeAllowed(chefId));
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // meals/{mealId} — public menu items, only the owning chef can edit
    // Admins (admin-web) can also edit/delete any meal.
    //
    // Plates left (2026-10-16): availableQuantity is "plates left today".
    // Besides the owning chef, a customer may (1) take plates in the same
    // transaction that creates their order - the amount must equal that new
    // order's mealQuantities[mealId] - and (2) give them back in the same
    // write that cancels a plate-reserving order (platesRestored false ->
    // true). Each order can reserve and restore only once.
    function plateReservationOk(mealId) {
      let oid = request.resource.data.get("lastOrderId", "");
      let taken = resource.data.get("availableQuantity", 0) - request.resource.data.availableQuantity;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["availableQuantity", "lastOrderId"]) &&
        oid is string && oid != "" && oid != resource.data.get("lastOrderId", "") &&
        request.resource.data.availableQuantity >= 0 && taken > 0 &&
        !exists(/databases/$(database)/documents/orders/$(oid)) &&
        getAfter(/databases/$(database)/documents/orders/$(oid)).data.customerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/orders/$(oid)).data.get("platesReserved", false) == true &&
        getAfter(/databases/$(database)/documents/orders/$(oid)).data.mealQuantities[mealId] == taken;
    }
    function plateRestoreOk(mealId) {
      let oid = request.resource.data.get("lastRestoreOrderId", "");
      let back = request.resource.data.availableQuantity - resource.data.get("availableQuantity", 0);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["availableQuantity", "lastRestoreOrderId"]) &&
        oid is string && oid != "" && back > 0 &&
        get(/databases/$(database)/documents/orders/$(oid)).data.get("platesReserved", false) == true &&
        get(/databases/$(database)/documents/orders/$(oid)).data.get("platesRestored", false) == false &&
        getAfter(/databases/$(database)/documents/orders/$(oid)).data.get("platesRestored", false) == true &&
        getAfter(/databases/$(database)/documents/orders/$(oid)).data.status == "Cancelled" &&
        get(/databases/$(database)/documents/orders/$(oid)).data.mealQuantities[mealId] == back;
    }
    match /meals/{mealId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (
        get(/databases/$(database)/documents/chefs/$(resource.data.chefId)).data.userId == request.auth.uid ||
        plateReservationOk(mealId) ||
        plateRestoreOk(mealId)
      ));
      allow delete: if isAdmin() || (isSignedIn() &&
        get(/databases/$(database)/documents/chefs/$(resource.data.chefId)).data.userId == request.auth.uid);
    }

    // orders/{orderId} — visible only to the customer who placed it, the
    // chef who is fulfilling it, or (once deliveryPartnerId is set on it)
    // the delivery partner assigned to it. Admins (admin-web) can
    // read/update any order (the main lever is changing `status`).
    // isAdmin() is also allowed on create so the Recycle Bin can restore a
    // cancelled-then-removed order back to its original id (admin-web now
    // moves a cancelled order to the Recycle Bin instead of just flipping
    // its status - see OrdersPage.tsx's changeStatus()).
    //
    // Hardening (2026-10-16): updates are now field-scoped per role -
    //  - customer: may only cancel, while still "Placed" - their own Cancel
    //    button only within 5 minutes of placing, or the 12h auto-expiry
    //    (runs client-side on read since there are no Cloud Functions);
    //  - chef: may only change status / cancel fields;
    //  - delivery partner: may only change status.
    function orderStatusKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["status", "cancelReason", "cancelledAt", "platesRestored"]);
    }
    function isOrderChef() {
      return get(/databases/$(database)/documents/chefs/$(resource.data.chefId)).data.userId == request.auth.uid;
    }
    // The fees and discounts on an order are computed on the client
    // (DeliveryQuoter, Rewards, coupons) because there are no Cloud Functions
    // to recompute them here, and rules can't do the distance maths. These are
    // sanity bounds, not a recomputation: they stop a tampered client writing
    // a negative total or a free-delivery-for-everyone fee, and nothing more.
    // Deliberately wide so a legitimate order never gets rejected - for
    // example right after an admin changes the fee in App Settings, while
    // some phones still hold the previous value. The delivery bound sits
    // above anything the app can produce: DeliveryQuotes.MAX_FEE caps one
    // kitchen's fee at 1000 and an area surcharge can at most double it.
    function orderMoneySane() {
      let d = request.resource.data;
      return d.get("deliveryFee", 0) is number && d.get("deliveryFee", 0) >= 0 &&
        d.get("deliveryFee", 0) <= 3000 &&
        d.get("platformFee", 0) is number && d.get("platformFee", 0) >= 0 &&
        d.get("platformFee", 0) <= 500 &&
        d.get("discount", 0) >= 0 &&
        d.get("pointsRedeemed", 0) >= 0 &&
        d.get("rankDiscount", 0) >= 0 && d.get("rankDiscount", 0) <= 60 &&
        d.get("totalPrice", 0) is number && d.get("totalPrice", 0) >= 0;
    }
    // AI agent orders (mcp-server/src/orders.ts, created by the MCP server's
    // service account, which bypasses these rules). Before an admin has
    // verified the advance payment they sit in one of these states and the
    // chef can't act on them:
    //   AwaitingConfirmation -> (customer taps Confirm in the app) -> AwaitingPayment
    //   AwaitingPayment -> (TrxID from the agent or the app) -> PaymentSubmitted
    //   PaymentSubmitted -> (admin-web verifies) -> Placed, or Cancelled
    function agentPending(status) {
      return status in ["AwaitingConfirmation", "AwaitingPayment", "PaymentSubmitted"];
    }
    // The customer confirms their agent's order inside its 15-minute window
    // (+1 min clock slack) and gets at most an hour (+1 min) to pay.
    function agentConfirmOk() {
      let d = request.resource.data;
      return resource.data.get("source", "") == "agent" &&
        resource.data.status == "AwaitingConfirmation" && d.status == "AwaitingPayment" &&
        d.diff(resource.data).affectedKeys().hasOnly(["status", "confirmedAt", "payBy"]) &&
        request.time.toMillis() <= resource.data.get("confirmBy", 0) + 60000 &&
        d.payBy is number && d.payBy <= request.time.toMillis() + 3660000;
    }
    // Paying from the app: the TrxID is claimed in payment_txn_ids in the same
    // batch, so one TrxID can never pay for two orders.
    function agentPaymentOk(orderId) {
      let d = request.resource.data;
      return resource.data.get("source", "") == "agent" &&
        resource.data.status == "AwaitingPayment" && d.status == "PaymentSubmitted" &&
        d.diff(resource.data).affectedKeys().hasOnly(["status", "paymentMethod", "paymentTransactionId", "paymentSubmittedAt", "paymentSubmittedVia"]) &&
        d.paymentMethod in ["BKASH", "NAGAD"] &&
        d.paymentTransactionId is string && d.paymentTransactionId.matches("^[A-Z0-9]{8,12}$") &&
        getAfter(/databases/$(database)/documents/payment_txn_ids/$(d.paymentMethod + "_" + d.paymentTransactionId)).data.orderId == orderId;
    }
    match /orders/{orderId} {
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        (request.resource.data.status == "Placed" || request.resource.data.status == "Pending") &&
        orderMoneySane());
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isOrderChef() ||
        resource.data.get("deliveryPartnerId", "") == request.auth.uid
      ));
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid && (agentConfirmOk() || agentPaymentOk(orderId))) ||
        (isSignedIn() && orderStatusKeysOnly() && (
        // Customer cancels an agent order that isn't paid yet (or it timed out).
        (resource.data.customerId == request.auth.uid &&
          resource.data.status in ["AwaitingConfirmation", "AwaitingPayment"] &&
          request.resource.data.status == "Cancelled" &&
          request.resource.data.cancelReason in ["customer", "auto_expired"]) ||
        (resource.data.customerId == request.auth.uid &&
          resource.data.status == "Placed" && request.resource.data.status == "Cancelled" && (
            // Customer's own cancel: only within 5 minutes of placing (+30s clock slack).
            // Not for agent orders: those are prepaid, so a cancel needs support (refund).
            (request.resource.data.cancelReason == "customer" &&
              resource.data.get("source", "") != "agent" &&
              request.time.toMillis() - resource.data.get("placedAt", 0) < 330000) ||
            // The 12h "chef never accepted" auto-cancel, applied by whichever client reads it
            // (for a pre-order the app also waits until its slot has passed).
            (request.resource.data.cancelReason == "auto_expired" &&
              request.time.toMillis() - resource.data.get("placedAt", 0) > 43200000)
          )) ||
        // The chef can't touch an agent order before TiffinBox has verified its payment.
        (isOrderChef() && !agentPending(resource.data.status)) ||
        (resource.data.get("deliveryPartnerId", "") == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
      ));
      // Admin only: Recycle Bin moves (a cancelled order) and the demo-data purge.
      allow delete: if isAdmin();
    }

    // payment_txn_ids/{METHOD_TXNID} - every bKash/Nagad TrxID used to pay an
    // agent order, so the same TrxID can't pay twice (a second create on the
    // same id is an update, which nobody may do). Written by the MCP server or
    // by the customer's app in the same batch that marks their order paid.
    match /payment_txn_ids/{txnKey} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(["orderId", "customerId", "method", "createdAt"]) &&
        request.resource.data.customerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == "PaymentSubmitted" &&
        txnKey == request.resource.data.method + "_" +
          getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentTransactionId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // coupons/{couponId} - promo codes. createdBy "admin" (platform-wide or
    // for one chef, from admin-web) or "chef" (a chef's own kitchen only,
    // from the app). Any signed-in user can read (checkout validates a typed
    // code). A chef can manage only their own chef-created coupons; admins
    // can manage (incl. cancel) every coupon. Customers may only bump
    // usedCount by exactly 1 when an order using the coupon is placed.
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.createdBy == "chef" &&
        request.resource.data.chefId == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.createdBy == "chef" && resource.data.chefId == request.auth.uid &&
          request.resource.data.chefId == request.auth.uid && request.resource.data.createdBy == "chef" &&
          resource.data.get("cancelledByAdmin", false) != true &&
          request.resource.data.get("cancelledByAdmin", false) != true) ||
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedCount"]) &&
          request.resource.data.usedCount == resource.data.get("usedCount", 0) + 1);
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.createdBy == "chef" && resource.data.chefId == request.auth.uid);
    }

    // delivery_partners/{partnerId} — doc id = a Firebase Auth uid created
    // ONLY by an admin (admin-web's Delivery Partners page) — there is no
    // self-signup path for this collection, unlike chefs/users. A partner
    // may read (and will, once the delivery-partner app exists, update) only
    // their own doc; only admins can create/delete entries or edit anyone
    // else's.
    match /delivery_partners/{partnerId} {
      allow read: if isAdmin() || isOwner(partnerId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwner(partnerId);
    }

    // reviews/{reviewId} — public read, only the verified buyer can create.
    // Admins (admin-web) can delete for moderation (flagging), and isAdmin()
    // is also allowed on create so the Recycle Bin can restore a deleted
    // review on the original customer's behalf.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.customerId == request.auth.uid) || isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // subscriptions/{subscriptionId} — a customer's recurring meal plan
    // with a chef (see data/firebase/FirestoreSubscriptionRepository.kt).
    // Added for the admin-web panel; lets the owning customer and admins
    // manage it (admins can also force-cancel from admin-web).
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.chefId == request.auth.uid ||
        (resource.data.chefId != "" && exists(/databases/$(database)/documents/chefs/$(resource.data.chefId)) &&
         get(/databases/$(database)/documents/chefs/$(resource.data.chefId)).data.userId == request.auth.uid)
      ));
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.chefId == request.auth.uid ||
        (resource.data.chefId != "" && exists(/databases/$(database)/documents/chefs/$(resource.data.chefId)) &&
         get(/databases/$(database)/documents/chefs/$(resource.data.chefId)).data.userId == request.auth.uid)
      ));
      allow delete: if isAdmin();
    }

    // admin_activity_log/{logId} — append-only audit trail written by
    // admin-web (see admin-web/src/lib/activityLog.ts) every time an admin
    // toggles/edits/deletes something or changes an order's status. Admins
    // can read it (to review the log in the "Activity Log" tab) and create
    // new entries, but nothing may ever be updated or deleted — that's what
    // makes it a trustworthy audit trail rather than just another mutable
    // collection.
    match /admin_activity_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // chats/{chatId} — one thread per customer+chef pair, id = "<customerId>_<chefId>".
    // Chefs now have their own real Firebase Auth uid (chefId == that uid,
    // see FirestoreChefRepository.kt), so both sides of the conversation —
    // and admin-web (see admin-web/src/components/ChatsPage.tsx), which can
    // read and reply to any thread — are checked here. Messages are
    // restricted to the thread's two participants or an admin (rather than
    // "any signed-in user", which previously let anyone read any chat by
    // guessing its id) via a lookup on the parent chat doc.
    match /chats/{chatId} {
      allow read, write: if isAdmin() || (isSignedIn() && (
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        resource.data.chefId == request.auth.uid
      ));

      match /messages/{messageId} {
        allow read, create, update: if isAdmin() || (isSignedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.chefId == request.auth.uid
        ));
        allow delete: if isAdmin();
      }
    }

    // notifications/{uid}/items/{itemId} — a user's in-app notification
    // history (see FirestoreNotificationRepository.kt), separate from FCM
    // push. Only the owner (or an admin) may ever READ their own inbox.
    // Writes are deliberately cross-user: a chef writes into their
    // customer's inbox on an order-status change, and admin-web writes into
    // a chef's inbox on approval — there's no Cloud Function to broker this
    // (free-tier constraint), so any signed-in user may create an entry in
    // anyone's inbox. The content written is always a plain, non-sensitive
    // status string from trusted client code paths, never arbitrary
    // user-authored text, and entries are never updatable or deletable.
    match /notifications/{uid}/items/{itemId} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isSignedIn() || isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // delivery_applications/{chefUid} - a chef's application to use
    // TiffinBox's own delivery service (FirestoreDeliveryApplicationRepository.kt).
    // The chef can create / edit / withdraw their own while it's "pending",
    // and re-apply (back to "pending") once it was rejected, cancelled or has
    // expired - never while an agreement is running. Only an admin
    // (admin-web's Delivery Applications page) can approve / renew / cancel.
    // The one non-admin status change: the chef's app may record a run-out
    // agreement as "expired" (no Cloud Functions to do it on a schedule).
    function deliveryAgreementRunning() {
      return resource.data.status == "approved" &&
        resource.data.get("validUntil", 0) > request.time.toMillis();
    }
    match /delivery_applications/{chefId} {
      allow read: if isAdmin() || isOwner(chefId);
      allow create: if isOwner(chefId) && request.resource.data.status == "pending";
      allow update: if isAdmin() || (isOwner(chefId) && (
        (request.resource.data.status == "pending" && !deliveryAgreementRunning()) ||
        (resource.data.status == "approved" && !deliveryAgreementRunning() &&
          request.resource.data.status == "expired" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "expiredAt"]))
      ));
      allow delete: if isAdmin() || (isOwner(chefId) && resource.data.status == "pending");
    }

    // recycle_bin/{collection}__{id} — admin-web's soft-delete trash (see
    // src/lib/recycleBin.ts): every "Delete" button across admin-web writes
    // a full data snapshot here right before removing the real doc, so a
    // deleted chef/meal/review/delivery partner/admin can be restored later
    // instead of being gone immediately. Admin-only end to end - there is no
    // customer/chef-facing path that ever reads or writes this collection.
    match /recycle_bin/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }

    // chef_verifications/{uid} — private NID photos + status for the
    // chef-verification flow. The chef submits their NID photo (base64);
    // admin-web reviews and sets nidVerified/kitchenVerified on the chef
    // doc (locked fields above). The NID photo is private: only the chef
    // themselves and admins can read it.
    match /chef_verifications/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      // Chef can create/update: submit NID photo, set status to "pending".
      // Admin can do anything (verify, reject, delete the photo).
      allow create: if isAdmin() || (isOwner(uid) &&
        request.resource.data.status == "pending");
      allow update: if isAdmin() || (isOwner(uid) &&
        request.resource.data.status == "pending" &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["nidVerified", "kitchenVerified"]));
      allow delete: if isAdmin();
    }

    // App-wide settings set from admin-web's App Settings page (e.g.
    // recommendRadiusKm, deliveryBaseFee, deliveryFeePerKm,
    // deliveryIncludedKm). Everyone may read (the app needs it before login
    // too); only admins write.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // delivery_surcharges/{surchargeId} — area-based delivery surcharges set
    // by admin-web (DeliverySurchargesPage). The app reads these before
    // checkout to apply any active surcharge for the customer's delivery area;
    // only admins create/update/delete them.
    match /delivery_surcharges/{surchargeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
